<robot name="yezibot">

    <link name="base_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.12" length="0.10"/>
            </geometry>
            <material name ="blue">
                <color rgba="0.1 0.1 1.0 0.5"/>
            </material>
        </visual>
    </link>

    <link name ="laser_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.02" length="0.02"/>
            </geometry>
            <material name ="black">
                 <color rgba = "0.0 0.0 0.0 0.5"/>
            </material>
        </visual>
    </link>

    <link name ="imu_link">
      <visual>
        <geometry>
            <box size="0.02 0.02 0.02"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        
      </visual>
    </link>

    <link name="right_wheel_link">
      <visual>
        <geometry>
            <cylinder radius="0.04" length="0.032"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <material name ="black">
            <color rgba ="0.0 0.0 0.0 0.5"/>      
        </material>
      </visual>
    </link>

     <link name="left_wheel_link">
      <visual>
        <geometry>
            <cylinder radius="0.04" length="0.032"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <material name ="black">
            <color rgba ="0.0 0.0 0.0 0.5"/>      
        </material>
      </visual>
    </link>

    <link name="caster_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
            <sphere radius="0.016"/>
        </geometry>
        <material name="black">
            <colcor rgba="0.0 0.0 0.0 0.5"/>
        </material>
      </visual>
    </link>

    <!-- Robot Footprint-->
    <link name="base_footprint"/>
   

    <joint name="laser_joint" type="fixed">
        <parent link="base_link"/>
        <child link="laser_link"/>
        <origin xyz="0.0 0.0 0.06" rpy="0.0 0.0 0.0"/> 
    </joint> 

    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0.0 0.0 0.02" rpy="0.0 0.0 0.0"/>
    </joint>
     
    <joint name ="right_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="right_wheel_link"/>
      <origin xyz="-0.02 -0.10 -0.06" rpy="1.57079 0.0 0.0"/>
      <axis xyz="1.0 0.0 0.0"/>
    </joint>

    <joint name ="left_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="left_wheel_link"/>
      <origin xyz="-0.02 0.10 -0.06" rpy="1.57079 0.0 0.0"/>
      <axis xyz="1.0 0.0 0.0"/>
    </joint>

    <joint name="caster_joint" type="fixed">
     <parent link="base_link"/>
     <child link="caster_link"/>
     <origin xyz="0.06 0.0 -0.066" rpy="0.0 0.0 0.0"/>
     <axis xyz="0.0 0.0 0.0"/>
     
    </joint>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link"/>
        <origin xyz="0.0 0.0 0.066" rpy="0.0 0.0 0.0"/>  
    </joint>

</robot>
